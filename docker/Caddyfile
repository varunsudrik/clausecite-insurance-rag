# TLS is automatic: a public $DOMAIN gets a Let's Encrypt certificate, `localhost` gets Caddy's internal CA.
# Caddy is the only proxy in front of the API, hence TRUST_PROXY_HOPS=1 there.
{$DOMAIN:localhost} {
	encode zstd gzip

	# /api/* → api:3001 with the /api prefix stripped. flush_interval -1 streams the chat SSE
	# response through immediately instead of buffering it.
	handle_path /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	# Everything else → the Next.js app. The API sets its own headers (helmet), so the CSP lives here.
	# 'unsafe-inline' is needed by Next's inline hydration scripts and styles; blob: workers by react-pdf.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
		-X-Powered-By
	}
}
