# Production configuration for docker-compose.prod.yml. Copy to `.env.prod` on the server
# (never commit it) and fill in every empty value:
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Not set here, because docker-compose.prod.yml wires them (and overrides any value given here):
#   DATABASE_URL, RABBITMQ_URL, REDIS_URL, CACHE_REDIS_URL (the bounded redis-cache, DECISIONS 009),
#   STORAGE_DIR (/data/pdfs: the `pdfs` volume shared by api and worker), TRUST_PROXY_HOPS=1
#   (Caddy is the single proxy hop), WEB_ORIGIN (https://$DOMAIN) and PORT.
# The values below that have no default (JWT_SECRET, ADMIN_PASSWORD) must be set before first start.
#
# Generate EVERY secret as URL-safe hex: openssl rand -hex 24 (openssl rand -hex 32 for JWT_SECRET).
# Several are embedded in connection URLs, and Compose interpolates `$` in env files, so base64
# characters (+ / =) and `$` break things. If you choose ADMIN_PASSWORD yourself and it contains a
# `$`, wrap it in single quotes so it stays literal: ADMIN_PASSWORD='pa$word-that-is-long-enough'

# --- images ---
# GitHub account or organisation that owns ghcr.io/<owner>/clausecite-{api,worker,web}
GHCR_OWNER=
# Image tag to run: a git sha, or `latest`
IMAGE_TAG=latest

# --- edge ---
# Public hostname. Caddy obtains and renews its TLS certificate automatically; the DNS record must
# already point at this server and ports 80 and 443 must be reachable.
DOMAIN=

# --- infrastructure credentials ---
# These go into connection URLs: URL-safe hex only (openssl rand -hex 24)
POSTGRES_PASSWORD=
RABBITMQ_USER=clausecite
RABBITMQ_PASSWORD=

# --- OpenRouter (https://openrouter.ai/keys) ---
# Set a credit limit on this key (Keys → Edit → Credit limit): it is the only spend bound that does
# not depend on application code (DECISIONS 012).
OPENROUTER_API_KEY=
# Model overrides; leave commented out to use the defaults shown.
#CHAT_MODEL=anthropic/claude-haiku-4.5
#CHAT_FALLBACK_MODELS=openai/gpt-4.1-mini
#REWRITE_MODEL=
# Changing EMBEDDING_MODEL mixes vector spaces: new queries would be compared with chunks embedded by the
# old model. After changing it, recreate api and worker, then Re-ingest every policy (Policies page).
# See docs/deploy.md, "Change EMBEDDING_MODEL".
#EMBEDDING_MODEL=openai/text-embedding-3-small
#RERANK_MODEL=cohere/rerank-v3.5

# --- auth ---
# Required, at least 32 chars; the API refuses to start with a short or placeholder value.
# Generate: openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=
# At least 12 chars. Anything shorter (or the `change-me` placeholder) and the admin is not seeded.
ADMIN_PASSWORD=

# --- spend protection (DECISIONS 012) ---
# Daily token budget per guest
GUEST_DAILY_TOKEN_BUDGET=50000
# Daily token cap for the whole deployment, guests and admins together (fail closed)
GLOBAL_DAILY_TOKEN_BUDGET=2000000
# Flat tokens charged per /search call and per refused chat (embedding + rerank cost)
SEARCH_TOKEN_COST=300

# --- ingestion ---
# Retry delays (ms) for a failed ingest: one retry queue per delay
INGEST_RETRY_DELAYS_MS=10000,60000,300000

# --- optional ---
# Where the backup service writes its daily pg_dump (default ./backups next to the compose file)
#BACKUP_DIR=./backups
