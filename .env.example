# --- infra (matches docker-compose.yml) ---
DATABASE_URL=postgres://clausecite:clausecite@localhost:5433/clausecite
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
# Bounded, evicting Redis for the query-embedding cache (the `redis-cache` service); unset = share REDIS_URL
CACHE_REDIS_URL=redis://localhost:6380
# Relative paths resolve from each app's cwd (apps/api, apps/worker) → both point at <repo>/data/pdfs.
# Docker sets an absolute path (/data/pdfs). The DB stores only the file name (<sha256>.pdf).
STORAGE_DIR=../../data/pdfs

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
CHAT_MODEL=anthropic/claude-haiku-4.5
CHAT_FALLBACK_MODELS=openai/gpt-4.1-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
RERANK_MODEL=cohere/rerank-v3.5

# --- retrieval ---
RERANK_THRESHOLD=0.2

# --- ingestion ---
INGEST_RETRY_DELAYS_MS=10000,60000,300000

# --- api ---
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Reverse proxies in front of the API (Express `trust proxy`). 0 = none: X-Forwarded-For is ignored.
# Set 1 behind exactly one proxy (Caddy in production); a wrong value lets clients spoof their IP.
TRUST_PROXY_HOPS=0
# required: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=admin@clausecite.local
# ≥ 12 chars; the API refuses to seed the admin with the placeholder
ADMIN_PASSWORD=change-me
API_KEY=
GUEST_DAILY_TOKEN_BUDGET=50000
# Spend protection: the whole deployment's daily token cap (guests and admins together)
GLOBAL_DAILY_TOKEN_BUDGET=2000000
# Flat tokens charged per /search call and per refused chat (embedding + rerank cost)
SEARCH_TOKEN_COST=300
